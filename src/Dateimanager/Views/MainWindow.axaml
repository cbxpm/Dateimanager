<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dateimanager.ViewModels"
        xmlns:views="using:Dateimanager.Views"
        x:Class="Dateimanager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="760" MinWidth="800" MinHeight="450"
        Title="Dateimanager">

    <Window.Resources>
        <StreamGeometry x:Key="CycleIcon">M12,6V9L16,5L12,1V4A8,8 0 0,0 4,12C4,13.57 4.46,15.03 5.24,16.26L6.7,14.8C6.25,13.97 6,13 6,12A6,6 0 0,1 12,6M18.76,7.74L17.3,9.2C17.74,10.04 18,11 18,12A6,6 0 0,1 12,18V15L8,19L12,23V20A8,8 0 0,0 20,12C20,10.43 19.54,8.97 18.76,7.74Z</StreamGeometry>

        <!-- Menüeinträge für die Liste der Knopfbänke -->
        <ControlTheme x:Key="BankMenuItemTheme" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                      x:DataType="vm:ButtonBankViewModel">
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="Command" Value="{Binding SelectCommand}" />
            <Setter Property="ToggleType" Value="Radio" />
            <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
        </ControlTheme>

        <ControlTheme x:Key="MoveTargetMenuItemTheme" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                      x:DataType="vm:BankMoveTarget">
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="Command" Value="{Binding MoveCommand}" />
        </ControlTheme>
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding CopyToOtherCommand}" />
        <KeyBinding Gesture="F6" Command="{Binding MoveToOtherCommand}" />
        <KeyBinding Gesture="Shift+F6" Command="{Binding RenameCommand}" />
        <KeyBinding Gesture="F7" Command="{Binding NewFolderCommand}" />
        <KeyBinding Gesture="F8" Command="{Binding MoveToTrashCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCommand}" />
        <KeyBinding Gesture="Ctrl+U" Command="{Binding SwapPanesCommand}" />
        <KeyBinding Gesture="Ctrl+H" Command="{Binding ToggleHiddenCommand}" />
        <KeyBinding Gesture="Alt+Left" Command="{Binding GoBackCommand}" />
        <KeyBinding Gesture="Alt+Right" Command="{Binding GoForwardCommand}" />
        <KeyBinding Gesture="Alt+Up" Command="{Binding GoUpCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ButtonBar.NextBankCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+B" Command="{Binding ButtonBar.PreviousBankCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <ProgressBar DockPanel.Dock="Right" Width="100" MinWidth="0" Margin="8,0"
                         IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <Menu>
                <MenuItem Header="_Dateien">
                    <MenuItem Header="Öffnen" Command="{Binding OpenSelectedCommand}" InputGesture="Enter" />
                    <MenuItem Header="Kopieren ins andere Fenster …" Command="{Binding CopyToOtherCommand}" InputGesture="F5" />
                    <MenuItem Header="Verschieben ins andere Fenster …" Command="{Binding MoveToOtherCommand}" InputGesture="F6" />
                    <MenuItem Header="Umbenennen …" Command="{Binding RenameCommand}" InputGesture="F2" />
                    <MenuItem Header="Neuer Ordner …" Command="{Binding NewFolderCommand}" InputGesture="F7" />
                    <MenuItem Header="In den Papierkorb" Command="{Binding MoveToTrashCommand}" InputGesture="F8" />
                    <MenuItem Header="Endgültig löschen" Command="{Binding DeletePermanentlyCommand}" InputGesture="Shift+Delete" />
                    <Separator />
                    <MenuItem Header="Beenden" Click="OnExitClick" InputGesture="Alt+F4" />
                </MenuItem>
                <MenuItem Header="_Auswahl">
                    <MenuItem Header="Alles auswählen" Command="{Binding SelectAllCommand}" InputGesture="Ctrl+A" />
                    <MenuItem Header="Auswahl aufheben" Command="{Binding SelectNoneCommand}" />
                    <MenuItem Header="Auswahl umkehren" Command="{Binding InvertSelectionCommand}" />
                </MenuItem>
                <MenuItem Header="A_nsicht">
                    <MenuItem Header="Versteckte Dateien anzeigen" ToggleType="CheckBox"
                              IsChecked="{Binding ShowHidden}" InputGesture="Ctrl+H" />
                    <Separator />
                    <MenuItem Header="Anderes Fenster aktivieren" Command="{Binding SwitchPaneCommand}" InputGesture="Tab" />
                    <MenuItem Header="Fenster tauschen" Command="{Binding SwapPanesCommand}" InputGesture="Ctrl+U" />
                    <MenuItem Header="Anderes Fenster gleichsetzen" Command="{Binding SyncPanesCommand}" />
                    <MenuItem Header="Aktualisieren" Command="{Binding RefreshCommand}" InputGesture="Ctrl+R" />
                    <Separator />
                    <MenuItem Header="Schriftart und Zeilenabstand …" Command="{Binding EditAppearanceCommand}" />
                </MenuItem>
                <MenuItem Header="_Knöpfe">
                    <MenuItem Header="Nächste Knopfbank" Command="{Binding ButtonBar.NextBankCommand}" InputGesture="Ctrl+B" />
                    <MenuItem Header="Vorherige Knopfbank" Command="{Binding ButtonBar.PreviousBankCommand}" InputGesture="Ctrl+Shift+B" />
                    <MenuItem Header="Knopfbank wählen" ItemsSource="{Binding ButtonBar.Banks}"
                              ItemContainerTheme="{StaticResource BankMenuItemTheme}" />
                    <Separator />
                    <MenuItem Header="Neue Knopfbank …" Command="{Binding ButtonBar.AddBankCommand}" />
                    <MenuItem Header="Knopfbank umbenennen …" Command="{Binding ButtonBar.RenameBankCommand}" />
                    <MenuItem Header="Knopfbank duplizieren" Command="{Binding ButtonBar.DuplicateBankCommand}" />
                    <MenuItem Header="Knopfbank nach vorn" Command="{Binding ButtonBar.MoveBankLeftCommand}" />
                    <MenuItem Header="Knopfbank nach hinten" Command="{Binding ButtonBar.MoveBankRightCommand}" />
                    <MenuItem Header="Knopfbank löschen …" Command="{Binding ButtonBar.RemoveBankCommand}" />
                    <Separator />
                    <MenuItem Header="Neuer Knopf …" Command="{Binding ButtonBar.AddButtonCommand}" />
                    <MenuItem Header="Spalten">
                        <MenuItem Header="4" Command="{Binding ButtonBar.SetColumnsCommand}">
                            <MenuItem.CommandParameter><x:Int32>4</x:Int32></MenuItem.CommandParameter>
                        </MenuItem>
                        <MenuItem Header="6" Command="{Binding ButtonBar.SetColumnsCommand}">
                            <MenuItem.CommandParameter><x:Int32>6</x:Int32></MenuItem.CommandParameter>
                        </MenuItem>
                        <MenuItem Header="8" Command="{Binding ButtonBar.SetColumnsCommand}">
                            <MenuItem.CommandParameter><x:Int32>8</x:Int32></MenuItem.CommandParameter>
                        </MenuItem>
                        <MenuItem Header="10" Command="{Binding ButtonBar.SetColumnsCommand}">
                            <MenuItem.CommandParameter><x:Int32>10</x:Int32></MenuItem.CommandParameter>
                        </MenuItem>
                        <MenuItem Header="12" Command="{Binding ButtonBar.SetColumnsCommand}">
                            <MenuItem.CommandParameter><x:Int32>12</x:Int32></MenuItem.CommandParameter>
                        </MenuItem>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Standardknöpfe wiederherstellen …" Command="{Binding ButtonBar.ResetToDefaultsCommand}" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- Knopfleiste wie bei Directory Opus: links der Umschalter für die Knopfbänke,
             Rechtsklick auf einen Knopf zum Bearbeiten -->
        <Border DockPanel.Dock="Bottom" Padding="4"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Left" x:Name="BankCycleButton" Classes="cycle"
                        Command="{Binding ButtonBar.NextBankCommand}"
                        FontFamily="{Binding Appearance.ButtonFontFamily}"
                        ToolTip.Tip="Knopfbank wechseln (Strg+B) – Rechtsklick: Bank wählen"
                        Focusable="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <PathIcon Data="{StaticResource CycleIcon}" Width="16" Height="16" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ButtonBar.CurrentBank.Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ButtonBar.BankPosition, StringFormat='Bank {0}'}"
                                       FontSize="11" Opacity="0.7" />
                        </StackPanel>
                    </Grid>
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding ButtonBar.Banks}"
                                     ItemContainerTheme="{StaticResource BankMenuItemTheme}" />
                    </Button.ContextMenu>
                </Button>

                <Panel Background="Transparent">
                    <Panel.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Neuer Knopf …" Command="{Binding ButtonBar.AddButtonCommand}" />
                            <MenuItem Header="Neue Knopfbank …" Command="{Binding ButtonBar.AddBankCommand}" />
                        </ContextMenu>
                    </Panel.ContextMenu>

                    <TextBlock Text="Leere Knopfbank – Rechtsklick hier, um einen Knopf hinzuzufügen."
                               IsVisible="{Binding ButtonBar.CurrentBank.IsEmpty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" Margin="8" />

                    <ItemsControl x:Name="ButtonBankItems" ItemsSource="{Binding ButtonBar.CurrentBank.Buttons}"
                                  FontFamily="{Binding Appearance.ButtonFontFamily}"
                                  FontSize="{Binding Appearance.ButtonFontSize}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding ButtonBar.CurrentBank.Columns}" Rows="{Binding ButtonBar.Rows}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommandButtonViewModel">
                                <Button Classes="bank" Content="{Binding Label}"
                                        Background="{Binding Background}" Foreground="{Binding Foreground}"
                                        Command="{Binding ExecuteCommand}" ToolTip.Tip="{Binding ToolTip}"
                                        Focusable="False">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Bearbeiten …" Command="{Binding EditCommand}" />
                                            <MenuItem Header="Neuer Knopf dahinter …" Command="{Binding AddAfterCommand}" />
                                            <MenuItem Header="Duplizieren" Command="{Binding DuplicateCommand}" />
                                            <Separator />
                                            <MenuItem Header="Nach links" Command="{Binding MoveLeftCommand}" />
                                            <MenuItem Header="Nach rechts" Command="{Binding MoveRightCommand}" />
                                            <MenuItem Header="In Knopfbank verschieben" ItemsSource="{Binding MoveTargets}"
                                                      IsVisible="{Binding HasMoveTargets}"
                                                      ItemContainerTheme="{StaticResource MoveTargetMenuItemTheme}" />
                                            <Separator />
                                            <MenuItem Header="Entfernen …" Command="{Binding RemoveCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="*,6,*" Margin="4,0,4,2">
            <views:PaneView x:Name="LeftPane" />
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
            <views:PaneView Grid.Column="2" x:Name="RightPane" />
        </Grid>
    </DockPanel>
</Window>
