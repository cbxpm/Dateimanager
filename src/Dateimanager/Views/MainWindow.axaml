<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dateimanager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
        x:Class="Dateimanager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="680" MinWidth="640" MinHeight="400"
        Title="{Binding CurrentPath, StringFormat='{}{0} – Dateimanager'}">

    <Window.Resources>
        <StreamGeometry x:Key="ArrowLeftIcon">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</StreamGeometry>
        <StreamGeometry x:Key="ArrowRightIcon">M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z</StreamGeometry>
        <StreamGeometry x:Key="ArrowUpIcon">M13,20H11V8L5.5,13.5L4.08,12.08L12,4.16L19.92,12.08L18.5,13.5L13,8V20Z</StreamGeometry>
        <StreamGeometry x:Key="RefreshIcon">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
        <StreamGeometry x:Key="FolderPlusIcon">M10,4L12,6H20A2,2 0 0,1 22,8V18A2,2 0 0,1 20,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10M15,9V12H12V14H15V17H17V14H20V12H17V9H15Z</StreamGeometry>
        <StreamGeometry x:Key="RenameIcon">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</StreamGeometry>
        <StreamGeometry x:Key="CutIcon">M19,3L13,9L15,11L22,4V3M12,12.5A0.5,0.5 0 0,1 11.5,12A0.5,0.5 0 0,1 12,11.5A0.5,0.5 0 0,1 12.5,12A0.5,0.5 0 0,1 12,12.5M6,20A2,2 0 0,1 4,18C4,16.89 4.9,16 6,16A2,2 0 0,1 8,18C8,19.11 7.1,20 6,20M6,8A2,2 0 0,1 4,6C4,4.89 4.9,4 6,4A2,2 0 0,1 8,6C8,7.11 7.1,8 6,8M9.64,7.64C9.87,7.14 10,6.59 10,6A4,4 0 0,0 6,2A4,4 0 0,0 2,6A4,4 0 0,0 6,10C6.59,10 7.14,9.87 7.64,9.64L10,12L7.64,14.36C7.14,14.13 6.59,14 6,14A4,4 0 0,0 2,18A4,4 0 0,0 6,22A4,4 0 0,0 10,18C10,17.41 9.87,16.86 9.64,16.36L12,14L19,21H22V20L9.64,7.64Z</StreamGeometry>
        <StreamGeometry x:Key="CopyIcon">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</StreamGeometry>
        <StreamGeometry x:Key="PasteIcon">M19,20H5V4H7V7H17V4H19M12,2A1,1 0 0,1 13,3A1,1 0 0,1 12,4A1,1 0 0,1 11,3A1,1 0 0,1 12,2M19,2H14.82C14.4,0.84 13.3,0 12,0C10.7,0 9.6,0.84 9.18,2H5A2,2 0 0,0 3,4V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V4A2,2 0 0,0 19,2Z</StreamGeometry>
        <StreamGeometry x:Key="DeleteIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="Button.tool PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tool:disabled PathIcon">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="PathIcon.folder">
            <Setter Property="Foreground" Value="#E3A33A" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Alt+Left" Command="{Binding GoBackCommand}" />
        <KeyBinding Gesture="Alt+Right" Command="{Binding GoForwardCommand}" />
        <KeyBinding Gesture="Alt+Up" Command="{Binding GoUpCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewFolderCommand}" />
        <KeyBinding Gesture="Ctrl+H" Command="{Binding ToggleHiddenCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- Navigationsleiste -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,220" Margin="8,8,8,4">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="tool" Command="{Binding GoBackCommand}" ToolTip.Tip="Zurück (Alt+Links)">
                    <PathIcon Data="{StaticResource ArrowLeftIcon}" />
                </Button>
                <Button Classes="tool" Command="{Binding GoForwardCommand}" ToolTip.Tip="Vorwärts (Alt+Rechts)">
                    <PathIcon Data="{StaticResource ArrowRightIcon}" />
                </Button>
                <Button Classes="tool" Command="{Binding GoUpCommand}" ToolTip.Tip="Übergeordneter Ordner (Alt+Hoch)">
                    <PathIcon Data="{StaticResource ArrowUpIcon}" />
                </Button>
                <Button Classes="tool" Command="{Binding RefreshCommand}" ToolTip.Tip="Aktualisieren (F5)">
                    <PathIcon Data="{StaticResource RefreshIcon}" />
                </Button>
            </StackPanel>

            <TextBox Grid.Column="1" x:Name="AddressBox" Margin="8,0"
                     Text="{Binding AddressText}"
                     PlaceholderText="Pfad eingeben …"
                     VerticalContentAlignment="Center">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding NavigateToAddressCommand}" />
                    <KeyBinding Gesture="Escape" Command="{Binding ResetAddressCommand}" />
                </TextBox.KeyBindings>
            </TextBox>

            <TextBox Grid.Column="2" x:Name="FilterBox"
                     Text="{Binding FilterText}"
                     PlaceholderText="Filtern (Strg+F)"
                     VerticalContentAlignment="Center" />
        </Grid>

        <!-- Werkzeugleiste -->
        <DockPanel DockPanel.Dock="Top" Margin="8,0,8,6">
            <CheckBox DockPanel.Dock="Right" Content="Versteckte Dateien (Strg+H)"
                      IsChecked="{Binding ShowHidden}" />
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="tool" Command="{Binding NewFolderCommand}" ToolTip.Tip="Neuer Ordner (Strg+Umschalt+N)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource FolderPlusIcon}" />
                        <TextBlock Text="Neuer Ordner" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Command="{Binding RenameCommand}" ToolTip.Tip="Umbenennen (F2)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource RenameIcon}" />
                        <TextBlock Text="Umbenennen" />
                    </StackPanel>
                </Button>
                <Separator Width="1" Height="20" Margin="6,0" />
                <Button Classes="tool" Command="{Binding CutCommand}" ToolTip.Tip="Ausschneiden (Strg+X)">
                    <PathIcon Data="{StaticResource CutIcon}" />
                </Button>
                <Button Classes="tool" Command="{Binding CopyCommand}" ToolTip.Tip="Kopieren (Strg+C)">
                    <PathIcon Data="{StaticResource CopyIcon}" />
                </Button>
                <Button Classes="tool" Command="{Binding PasteCommand}" ToolTip.Tip="Einfügen (Strg+V)">
                    <PathIcon Data="{StaticResource PasteIcon}" />
                </Button>
                <Separator Width="1" Height="20" Margin="6,0" />
                <Button Classes="tool" Command="{Binding MoveToTrashCommand}" ToolTip.Tip="In den Papierkorb (Entf) – endgültig: Umschalt+Entf">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource DeleteIcon}" />
                        <TextBlock Text="Löschen" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Statusleiste -->
        <Border DockPanel.Dock="Bottom" Padding="10,4"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" MinWidth="0"
                             IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="210,4,*">
            <!-- Seitenleiste -->
            <ListBox ItemsSource="{Binding Locations}"
                     SelectedItem="{Binding SelectedLocation}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocationViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="10" ToolTip.Tip="{Binding Path}">
                            <PathIcon Data="{Binding Icon}" Width="16" Height="16" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

            <!-- Dateiliste -->
            <DataGrid Grid.Column="2" x:Name="FileGrid"
                      ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column">
                <DataGrid.KeyBindings>
                    <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
                    <KeyBinding Gesture="Delete" Command="{Binding MoveToTrashCommand}" />
                    <KeyBinding Gesture="Shift+Delete" Command="{Binding DeletePermanentlyCommand}" />
                    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
                    <KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}" />
                    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
                </DataGrid.KeyBindings>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Öffnen" Command="{Binding OpenSelectedCommand}" InputGesture="Enter" />
                        <Separator />
                        <MenuItem Header="Ausschneiden" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
                        <MenuItem Header="Kopieren" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
                        <MenuItem Header="Einfügen" Command="{Binding PasteCommand}" InputGesture="Ctrl+V" />
                        <Separator />
                        <MenuItem Header="Umbenennen" Command="{Binding RenameCommand}" InputGesture="F2" />
                        <MenuItem Header="In den Papierkorb" Command="{Binding MoveToTrashCommand}" InputGesture="Delete" />
                        <MenuItem Header="Endgültig löschen" Command="{Binding DeletePermanentlyCommand}" InputGesture="Shift+Delete" />
                        <Separator />
                        <MenuItem Header="Neuer Ordner" Command="{Binding NewFolderCommand}" InputGesture="Ctrl+Shift+N" />
                        <MenuItem Header="Aktualisieren" Command="{Binding RefreshCommand}" InputGesture="F5" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="*" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FileEntryViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0"
                                            Opacity="{Binding Opacity}">
                                    <PathIcon Data="{Binding Icon}" Width="16" Height="16"
                                              Classes.folder="{Binding IsDirectory}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Größe" SortMemberPath="Size" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FileEntryViewModel">
                                <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Margin="10,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Typ" SortMemberPath="Type" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FileEntryViewModel">
                                <TextBlock Text="{Binding TypeText}" VerticalAlignment="Center" Margin="10,0"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Geändert am" SortMemberPath="Modified" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FileEntryViewModel">
                                <TextBlock Text="{Binding LastModifiedText}" VerticalAlignment="Center" Margin="10,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
